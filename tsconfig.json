{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "firefox-auth.ts",
    "chrome-auth.ts",
    "chromium-auth.ts",
    "chromium-cookies.ts",
    "safari-auth.ts",
    "sqlite-cookies.ts",
    "lumo-domain.ts",
    "test/**/*.ts"
  ]
}
